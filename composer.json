{
    "name": "d4h/finediff",
    "description": "PHP implementation of a Fine granularity Diff engine",
    "license": "MIT",
    "keywords": ["finediff", "diff", "text", "string", "opcode"],
    "authors": [
        {
            "name": "Raymond Hill"
        },
        {
            "name": "Rob Crowe"
        },
        {
            "name": "Hannes Van De Vreken",
            "email": "vandevreken.hannes@gmail.com"
        },
        {
            "name": "Igor Finagin",
            "email": "igor@finag.in"
        }
    ],
    "type": "library",
    "require": {
        "ext-mbstring": "*",
        "php": "~8.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^8.5 || ^9.2"
    },
    "autoload": {
        "psr-4": {
            "FineDiff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FineDiff\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "tests": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
